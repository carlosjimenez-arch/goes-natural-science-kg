{"$defs":{"EdgeType":{"enum":["PREREQUISITE","CO_REQUISITE","REFINES","TRANSFERS_TO"],"title":"EdgeType","type":"string"},"Identity":{"additionalProperties":false,"description":"Persistent editorial namespace/key; changing it denotes a different entity.","properties":{"key":{"maxLength":80,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","title":"Key","type":"string"},"namespace":{"maxLength":80,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","title":"Namespace","type":"string"}},"required":["namespace","key"],"title":"Identity","type":"object"}},"additionalProperties":false,"description":"Directed source→target; CO_REQUISITE endpoints are canonicalized as unordered.","properties":{"id":{"pattern":"^(skill|micro|edge|source|unit|grade)-[a-z0-9-]+-[0-9a-f]{16}$","title":"Id","type":"string"},"identity":{"$ref":"#/$defs/Identity"},"justification":{"minLength":1,"title":"Justification","type":"string"},"kind":{"const":"edge","default":"edge","title":"Kind","type":"string"},"schema_version":{"const":"edge/1.0","default":"edge/1.0","title":"Schema Version","type":"string"},"source":{"pattern":"^(skill|micro|edge|source|unit|grade)-[a-z0-9-]+-[0-9a-f]{16}$","title":"Source","type":"string"},"source_refs":{"items":{"pattern":"^(skill|micro|edge|source|unit|grade)-[a-z0-9-]+-[0-9a-f]{16}$","type":"string"},"minLength":1,"title":"Source Refs","type":"array"},"strength":{"maximum":1,"minimum":0,"title":"Strength","type":"number"},"target":{"pattern":"^(skill|micro|edge|source|unit|grade)-[a-z0-9-]+-[0-9a-f]{16}$","title":"Target","type":"string"},"type":{"$ref":"#/$defs/EdgeType"}},"required":["id","identity","source","target","type","strength","justification","source_refs"],"title":"Edge","type":"object"}
